{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "outDir": "./.build",
    "rootDir": "./src",
    "declaration": false,
    "skipLibCheck": true,
    "noEmitOnError": true
  },
  "include": [
    "src"
  ]
}
